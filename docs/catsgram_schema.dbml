Table users {
  id bigint [increment, primary key, ref: < posts.author_id]
  username varchar(40) [not null]
  email varchar(255) [not null]
  password varchar(40) [not null]
  registration_date timestampz [not null]
}

Table posts {
  id bigint [increment, primary key, ref: < image_storage.post_id]
  author_id bigint [not null]
  description text 
  post_date timestampz [not null]
}

Table image_storage {
  id bigint [increment, primary key]
  original_name varchar(255)
  file_path varchar(1024)
  post_id bigint [not null]
}